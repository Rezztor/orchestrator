# Copy to .env next to compose.yaml. Passwords and tokens go into URLs: use letters and digits only.
ORCH_VERSION=0.6.0
ORCH_PUBLIC_URL=https://orchestrator.example.internal
ORCH_HTTPS_PORT=443
ORCH_DB_OWNER_PASSWORD=
ORCH_DB_APP_PASSWORD=
# openssl rand -hex 32, one each
ORCH_ANSIBLE_TOKEN=
ORCH_TOFU_TOKEN=
# Any OpenAI-compatible endpoint ending in /v1, reachable from this host
ORCH_MODEL_URL=
ORCH_MODEL=
ORCH_MODEL_KEY=
ORCH_REVIEW_MODEL=
# Optional integrations
ORCH_SOLARWINDS_URL=
ORCH_SOLARWINDS_USER=
ORCH_SOLARWINDS_PASSWORD=
ORCH_SNOW_URL=
ORCH_SNOW_USER=
ORCH_SNOW_PASSWORD=
ORCH_SIEM_TARGET=
ORCH_SIEM_FORMAT=json
# Signed audit anchors: openssl genpkey -algorithm ed25519 -out keys/anchor.key, then
ORCH_ANCHOR_KEY=
